# Discord Bot Token (from Discord Developer Portal)
TOKEN=your_discord_bot_token_here

# PostgreSQL connection string (e.g. Neon, Supabase, local PostgreSQL)
# Example: postgresql://postgres:password@localhost:5432/rass_derb
DATABASE_URL=postgresql://user:password@host:port/dbname

# Optional: Specific Discord Server (Guild) ID for instant slash command testing during development
# GUILD_ID=123456789012345678
